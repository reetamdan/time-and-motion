# All text files are LF, on every platform. Bash scripts run inside WSL/Linux and break
# with CRLF, and several files (extractor, configs, deepstream.sh) are pinned by SHA-256
# in configs/models.yaml, so a checkout must reproduce them byte for byte.
* text=auto eol=lf
# Windows batch files need CRLF for cmd.exe.
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary
*.so binary

# Large data in Git LFS (install git-lfs before cloning to get the real files):
# footage, model weights/engines, raw per-frame evidence, databases and tensors.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.jsonl filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
*.db-wal filter=lfs diff=lfs merge=lfs -text
*.db-shm filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
*.f32le filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text

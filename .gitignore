# Rebuildable local environments and toolchains (recreated by scripts/setup and README §2)
.venv/
.venv-*/
node_modules/
.install/

# Temporary and cache folders
.tmp/
.pytest_tmp*/
.pytest_cache/
__pycache__/
*.py[cod]
# Copies of whole venvs/node_modules made inside validation runs (scripts/validate_documented_commands.py)
reports/**/scratch/venv-*/
reports/**/scratch/frontend/node_modules/

# Secrets and key material (MediaMTX writes a throwaway self-signed auto.crt/auto.key)
.env
*.key
*.pem
*.crt

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

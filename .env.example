# Safe orchestration defaults only. Copy to a trusted local .env and load explicitly.
# No real credentials belong in this file or in committed YAML.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
CCTV_API_URL=http://127.0.0.1:8000
CCTV_API_TIMEOUT_SECONDS=15
CCTV_START_TIMEOUT_SECONDS=90

# Production: FastAPI serves frontend/dist. Development: run-frontend uses Vite dev.
CCTV_FRONTEND_MODE=dev
CCTV_CONFIG_DIR=./configs
CCTV_DATA_DIR=./data
CCTV_MODEL_DIR=./models
CCTV_OFFLINE=1

# Supported libraries only: these flags do not supply missing local artifacts.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# Optional local API credential; leave blank here and set only in a local secret store.
CCTV_API_TOKEN=

# Optional installation/runtime paths. Bash/WSL uses .venv-wsl by default;
# Windows uses .venv-windows or an existing Windows .venv. Never cross-use them.
# PYTHON=/absolute/path/to/project/.venv-wsl/bin/python
# CCTV_VENV=/absolute/path/to/project/.venv-wsl
# BACKEND_REQUIREMENTS=/absolute/path/to/project/backend/requirements.txt

# Optional installation-time offline Python artifacts.
# CCTV_WHEELHOUSE=/absolute/path/to/project/.install/wheels

# Optional probe timeout and intended already-retained container reference.
CCTV_PROBE_TIMEOUT_SECONDS=60
# CCTV_CONTAINER_IMAGE=repository/image@sha256:REPLACE_WITH_REAL_DIGEST

# Never put a real RTSP URL with userinfo/password here. Use a local secret mechanism
# supported by the application and verify redaction before connecting a camera.
